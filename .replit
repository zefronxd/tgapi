modules = ["nodejs-20", "bash"]

[nix]
channel = "stable-25_05"
packages = ["deno", "yt-dlp", "ffmpeg"]

[agent]
expertMode = true

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow]]
name = "Start application"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "PORT=5000 deno task start:local"
waitForPort = 5000

[workflows.workflow.metadata]
outputType = "webview"

[[ports]]
localPort = 5000
externalPort = 80

[userenv]

[userenv.shared]
TELEGRAM_CACHE_CHANNEL_ID = "-1004466923479"
TELEGRAM_ADMIN_CHAT_ID = "8634611555"
